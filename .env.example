# Everything is optional. With no keys the app runs on the built-in mock PayPal and a stand-in model.
PORT=3003
PUBLIC_URL=http://localhost:3003

# PayPal sandbox REST app (Transaction Search, Payments, Invoicing enabled). Sandbox only.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Host for the SDK path. Sandbox only (the app refuses other hosts). Leave empty for the default.
PAYPAL_API_BASE=
# Required when the two values above are set: signs the one-time owner approval links.
APPROVAL_SECRET=
# Seed periods with sandbox card payments (payment_source.card). See VERIFY.md item 3.
SEED_WITH_CARD=0

# LLM_BACKEND=account runs Claude through your local Claude Code login (local use only, never the API key).
LLM_BACKEND=
# Prepared sandbox period files (written by scripts/seed-period.js). Default data/periods.
PERIODS_DIR=
# Sandbox buyer for scripts/approve-buyer.py
SANDBOX_BUYER_EMAIL=
SANDBOX_BUYER_PASSWORD=

# Claude. Without a key the Close Agent answers from a small deterministic stand-in.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# AG Studio trial key from the hackathon link (build time). Without it Studio shows its trial notice.
VITE_AG_STUDIO_LICENSE_KEY=

# Prepared periods and demo limits
READY_PERIOD_TARGET=5
PERIOD_MAX_AGE_DAYS=3
ASSIGN_PER_DAY=200
CHAT_PER_IP_HOUR=40
CHAT_PER_DAY=200

# Set to 1 to ignore every key above and run fully on mocks.
FORCE_MOCK=0
